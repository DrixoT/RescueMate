# RescueMate Emergency Backend Environment Configuration

# Server Configuration
PORT=3000
NODE_ENV=development

# Twilio Configuration (Emergency Contact Calling - Phase 1)
TWILIO_ACCOUNT_SID=your_twilio_account_sid_here
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
TWILIO_PHONE_NUMBER=your_twilio_phone_number_here

# RESERVED FOR FUTURE - Twilio Emergency Services (Phase 3 - $75 cost)
# TWILIO_EMERGENCY_SERVICES_ENABLED=false
# TWILIO_E911_ADDRESS_SID=your_e911_address_sid_here

# Database Configuration
MONGODB_URI=mongodb://localhost:27017/rescuemate-emergency

# Authentication
JWT_SECRET=your_jwt_secret_key_here_change_in_production
JWT_EXPIRATION=24h

# LLM API Keys (Optional - for health analysis)
OPENAI_API_KEY=your_openai_api_key_here
CLAUDE_API_KEY=your_claude_api_key_here

# Emergency Configuration
EMERGENCY_WEBHOOK_URL=https://your-app-domain.com/emergency/webhook
CONTACT_CALL_TIMEOUT_SECONDS=45
MAX_CONCURRENT_CALLS=5

# Logging
LOG_LEVEL=info
LOG_FILE=./logs/emergency.log

# Security
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Google Maps API (for geocoding)
GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

