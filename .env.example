# Environment Variables for Backend
# Copy this file to .env and fill in your actual values
# NEVER commit .env file to git!

# ElevenLabs API Key
ELEVENLABS_API_KEY=sk_73772cb99a08207ceb32537e3da1b773276c46fda0b7f428

# Google Maps API Key (for geocoding and location services)
GOOGLE_MAPS_API_KEY=your-google-maps-api-key-here

# Frontend URL (for CORS) - Update for production
FRONTEND_URL=http://localhost:5173

# Server Port
PORT=3000

# JWT Secret (for authentication - generate a random string)
JWT_SECRET=rescuemate_secret_key_change_in_production_12345

# Database URL (optional, for production)
DATABASE_URL=postgresql://user:password@localhost:5432/rescuemate

# Environment
NODE_ENV=development

# API Rate Limits
MAX_CALLS_PER_15_MIN=5
MAX_CALLS_PER_HOUR=20
MAX_CALLS_PER_DAY=100

